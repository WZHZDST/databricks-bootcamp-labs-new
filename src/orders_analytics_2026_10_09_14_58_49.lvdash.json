      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  fact_orders"
      ],
      "schema": "dev_zdenek_strbik_sales"
    },
    {
      "asset_name": "bootcamp_dev.dev_zdenek_strbik_sales.orders_metrics",
      "displayName": "Orders Metrics",
      "name": "orders_metrics"
    },
    {
      "config": {
        "comment": "Customer churn risk analysis",
        "dimensions": [
          {
            "displayName": "Churn Status",
            "expr": "CASE WHEN churn_predicted = 1 THEN 'At Risk' ELSE 'Retained' END",
            "name": "churn_status"
          },
          {
            "expr": "segment",
            "name": "segment"
          },
          {
            "expr": "region",
            "name": "region"
          }
        ],
        "measures": [
          {
            "displayName": "Customers",
            "expr": "COUNT(DISTINCT customer_id)",
            "name": "customer_count"
          },
          {
            "displayName": "At-Risk Customers",
            "expr": "COUNT(DISTINCT CASE WHEN churn_predicted = 1 THEN customer_id END)",
            "name": "at_risk_count"
          },
          {
            "displayName": "Churn Rate",
            "expr": "COUNT(DISTINCT CASE WHEN churn_predicted = 1 THEN customer_id END) * 1.0 / COUNT(DISTINCT customer_id)",
            "format": {
              "decimalPlaces": {
                "places": 1,
                "type": "exact"
              },
              "type": "percentage"
            },
            "name": "churn_rate"
          },
          {
            "displayName": "Revenue at Risk",
            "expr": "SUM(CASE WHEN churn_predicted = 1 THEN amount ELSE 0 END)",
            "format": {
              "currencyCode": "USD",
              "decimalPlaces": {
                "places": 0,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "revenue_at_risk"
          }
        ],
        "source": "SELECT cp.customer_id, cp.churn_predicted, oe.segment, oe.region, oe.amount, oe.order_id FROM bootcamp_dev.dev_zdenek_strbik_sales.churn_predictions cp LEFT JOIN bootcamp_dev.dev_zdenek_strbik_sales.orders_enriched oe ON cp.customer_id = oe.customer_id\n",
        "version": "1.1"
      },
      "displayName": "Churn Predictions",
      "name": "churn"
    },
    {
      "config": {
        "comment": "Product performance metrics",
        "dimensions": [
          {
            "displayName": "Product",
            "expr": "product_name",
            "name": "product_name"
          },
          {
            "expr": "category",
            "name": "category"
          },
          {
            "expr": "region",
            "name": "region"
          },
          {
            "expr": "channel",
            "name": "channel"
          }
        ],
        "measures": [
          {
            "displayName": "Revenue",
            "expr": "SUM(amount)",
            "format": {
              "currencyCode": "USD",
              "decimalPlaces": {
                "places": 0,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "revenue"
          },
          {
            "displayName": "Orders",
            "expr": "COUNT(DISTINCT order_id)",
            "name": "order_count"
          },
          {
            "displayName": "Units Sold",
            "expr": "SUM(quantity)",
            "name": "units_sold"
          },
          {
            "displayName": "Avg Selling Price",
            "expr": "SUM(amount) / SUM(quantity)",
            "format": {
              "currencyCode": "USD",
              "decimalPlaces": {
                "places": 2,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "avg_selling_price"
          }
        ],
        "source": "SELECT o.product_id, p.name AS product_name, p.category, p.list_price,\n       o.amount, o.quantity, o.order_id, o.region, o.channel\nFROM bootcamp_dev.dev_zdenek_strbik_sales.orders_enriched o JOIN bootcamp_dev.dev_zdenek_strbik_sales.products p ON o.product_id = p.product_id\n",
        "version": "1.1"
      },
      "displayName": "Top Products",
      "name": "top_products"
    },
    {
      "config": {
        "comment": "Detailed order-level metrics for deep-dive analysis",
        "dimensions": [
          {
            "displayName": "Order Date",
            "expr": "order_date",
            "format": {
              "dateFormat": "year_month_day",
              "type": "date"
            },
            "name": "order_date"
          },
          {
            "displayName": "Order Week",
            "expr": "DATE_TRUNC('WEEK', order_date)",
            "format": {
              "dateFormat": "year_month_day",
              "type": "date"
            },
            "name": "order_week"
          },
          {
            "displayName": "Order Month",
            "expr": "DATE_TRUNC('MONTH', order_date)",
            "format": {
              "dateFormat": "locale_short_month",
              "type": "date"
            },
            "name": "order_month"
          },
          {
            "expr": "region",
            "name": "region"
          },
          {
            "expr": "segment",
            "name": "segment"
          },
          {
            "expr": "category",
            "name": "category"
          },
          {
            "expr": "channel",
            "name": "channel"
          },
          {
            "expr": "coupon_code",
            "name": "coupon_code"
          },
          {
            "displayName": "Coupon Usage",
            "expr": "CASE WHEN coupon_code IS NOT NULL AND coupon_code != '' THEN 'With Coupon' ELSE 'No Coupon' END",
            "name": "has_coupon"
          }
        ],
        "measures": [
          {
            "displayName": "Revenue",
            "expr": "SUM(amount)",
            "format": {
              "currencyCode": "USD",
              "decimalPlaces": {
                "places": 0,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "revenue"
          },
          {
            "displayName": "Orders",
            "expr": "COUNT(DISTINCT order_id)",
            "name": "order_count"
          },
          {
            "displayName": "Units Sold",
            "expr": "SUM(quantity)",
            "name": "units_sold"
          },
          {
            "displayName": "Avg Order Value",
            "expr": "SUM(amount) / COUNT(DISTINCT order_id)",
            "format": {
              "currencyCode": "USD",
              "decimalPlaces": {
                "places": 2,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "avg_order_value"
          },
          {
            "displayName": "Avg Unit Price",
            "expr": "SUM(amount) / SUM(quantity)",
            "format": {
              "currencyCode": "USD",
              "decimalPlaces": {
                "places": 2,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "avg_unit_price"
          },
          {
            "displayName": "Coupon Usage Rate",
            "expr": "COUNT(DISTINCT CASE WHEN coupon_code IS NOT NULL AND coupon_code != '' THEN order_id END) * 1.0 / COUNT(DISTINCT order_id)",
            "format": {
              "decimalPlaces": {
                "places": 1,
                "type": "exact"
              },
              "type": "percentage"
            },
            "name": "coupon_order_rate"
          }
        ],
        "source": "bootcamp_dev.dev_zdenek_strbik_sales.orders_enriched",
        "version": "1.1"
      },
      "displayName": "Sales Detail",
      "name": "sales_detail"
    }
